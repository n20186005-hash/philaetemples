            <p class="mt-4 max-w-2xl text-white/70">لا تكتفِ بالأرقام — إليك ما يعنيه الطقس عملياً لرحلتك إلى الجزيرة.</p>
          </div>

          {weather && currentInfo && advice ? (
            <>
              {/* Base card: temperature, condition, rain prob, wind */}
              <div class="grid gap-6 lg:grid-cols-[1.1fr_1.9fr]">
                <div class="rounded-[2rem] bg-[#0d5553] p-8">
                  <p class="text-sm font-bold text-[#f6c981]">الآن في أسوان</p>
                  <div class="mt-3 flex items-center gap-4">
                    <span class="text-6xl">{currentInfo.icon}</span>
                    <span class="text-6xl font-extrabold">{Math.round(weather.current.temperature)}°</span>
                  </div>
                  <p class="mt-2 text-lg font-bold">{currentInfo.label}</p>
                  <div class="mt-6 grid grid-cols-2 gap-4 text-sm text-white/80">
                    <div><span class="block text-white/55">الإحساس الحراري</span>{Math.round(weather.current.apparent)}°</div>
                    <div><span class="block text-white/55">احتمال المطر اليوم</span>{today?.rainProb ?? 0}%</div>
                    <div><span class="block text-white/55">الرياح</span>{Math.round(weather.current.wind)} كم/س · {windNow?.word}</div>
                    <div><span class="block text-white/55">الأشعة</span>{Math.round(weather.current.uv)}</div>
                  </div>
                </div>

                <div class="rounded-[2rem] border border-white/15 p-8">
                  <p class="mb-5 text-sm font-bold text-[#f6c981]">توقّع الأيام القادمة</p>
                  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
                    {weather.days.map((d) => {
                      const info = describeCode(d.code);
                      return (
                        <div class="rounded-2xl bg-white/5 p-4 text-center">
                          <p class="text-xs text-white/60">{weekday(d.date)}</p>
                          <p class="mt-1 text-xs text-white/40">{d.date.slice(8, 10)}</p>
                          <p class="my-2 text-3xl">{info.icon}</p>
                          <p class="text-sm font-bold">{Math.round(d.tmax)}°</p>
                          <p class="text-xs text-white/55">{Math.round(d.tmin)}°</p>
                          <p class="mt-1 text-[10px] text-white/45">مطر {d.rainProb}%</p>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>

              {/* Risk banner — only when there is a real risk */}
              {advice.risks.length > 0 && (
                <div class="mt-6 rounded-[2rem] border border-red-400/40 bg-red-500/15 p-6">
                  <p class="mb-2 text-sm font-extrabold text-red-200">⚠️ تنبيه</p>
                  <ul class="space-y-2 text-sm leading-7 text-red-100">
                    {advice.risks.map((r) => <li>{r}</li>)}
                  </ul>
                </div>
              )}

              {/* Smart advice — dynamic, only relevant blocks shown */}
              <div class="mt-6 grid gap-5 md:grid-cols-3">
                {advice.travel.length > 0 && (
                  <div class="rounded-[2rem] bg-white/5 p-7">
                    <p class="mb-4 flex items-center gap-2 text-sm font-bold text-[#f6c981]">✅ الاستعداد والملبس</p>
                    <ul class="space-y-3 text-sm leading-7 text-white/85">
                      {advice.travel.map((t) => <li>{t}</li>)}
                    </ul>
                  </div>
                )}
                {advice.activity.length > 0 && (
                  <div class="rounded-[2rem] bg-white/5 p-7">
                    <p class="mb-4 flex items-center gap-2 text-sm font-bold text-[#f6c981]">✅ ترتيب الزيارة</p>
                    <ul class="space-y-3 text-sm leading-7 text-white/85">
                      {advice.activity.map((t) => <li>{t}</li>)}
                    </ul>
                  </div>
                )}
                {advice.items.length > 0 && (
                  <div class="rounded-[2rem] bg-white/5 p-7">
                    <p class="mb-4 flex items-center gap-2 text-sm font-bold text-[#f6c981]">🎒 ما تأخذ معك</p>
                    <ul class="space-y-3 text-sm leading-7 text-white/85">
                      {advice.items.map((t) => <li>{t}</li>)}
                    </ul>
                  </div>
                )}
                {advice.travel.length === 0 && advice.activity.length === 0 && advice.items.length === 0 && (
                  <div class="rounded-[2rem] bg-white/5 p-7 text-sm leading-7 text-white/75 md:col-span-3">
                    أحوالٌ معتدلة عموماً اليوم — استمتع بزيارتك دون قلق خاص.
                  </div>
                )}
              </div>
            </>
          ) : (
            <p class="rounded-[2rem] border border-white/15 bg-white/5 p-8 text-white/70">تعذّر تحميل بيانات الطقس حالياً؛ أعد المحاولة لاحقاً.</p>
          )}
        </div>
      </section>

