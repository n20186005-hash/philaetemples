  '@context':'https://schema.org','@type':'TouristAttraction','name':'معبد فيله','alternateName':'Philae Temple','description':'معبد جزيري مخصص للإلهة إيزيس، يصل إليه الزائر بالقارب وسط مياه النيل في أسوان.','url':canonical,'image':site ? new URL('/images/aswan-nile.jpg',site).toString() : '/images/aswan-nile.jpg','address':{'@type':'PostalAddress','streetAddress':'أول أسوان','addressLocality':'أسوان 1','addressRegion':'محافظة أسوان','postalCode':'1240271','addressCountry':'EG'},'geo':{'@type':'GeoCoordinates','latitude':24.0255836,'longitude':32.8841021},'openingHours':'Mo-Su 07:00-17:00','aggregateRating':{'@type':'AggregateRating','ratingValue':'4.8','reviewCount':'14787'}
};
