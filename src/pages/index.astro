---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuidePage from '../components/GuidePage.astro';
import { ar } from '../content/ar';
import { attractionSchema, faqSchema } from '../lib/schema';
import { SITE } from '../data/site';
import { hreflangAlternates } from '../i18n';

const site = Astro.site ?? new URL(`https://${SITE.domain}`);
const path = Astro.url.pathname;
const canonical = new URL(path, site).toString();
const alternates = hreflangAlternates(site, path);
const jsonLd = [attractionSchema('ar'), faqSchema(ar.faq.items)];

const title = 'معبد فيله: المواعيد والتذاكر والقارب | دليل مستقل';
const description = 'مواعيد معبد فيله الرسمية وآخر دخول، اختلاف وقت الخرائط، أسعار التذاكر حسب الفئة، وتخطيط القارب إلى أجيليكا. دليل مستقل مع مصادر رسمية وطقس النموذج قرب أسوان.';
---

<BaseLayout locale="ar" title={title} description={description} canonical={canonical} alternates={alternates} jsonLd={jsonLd}>
  <GuidePage locale="ar" c={ar} />
</BaseLayout>
