---
import '../styles/global.css';
import { getWeather, describeCode, buildAdvice, windInfo } from '../lib/weather';

// ---- Single-attraction SEO entity binding (per template) ----
const domain = 'philaetemples.com';
const site = Astro.site || new URL(`https://${domain}`);
const canonical = new URL(Astro.url.pathname, site).toString();
const mapsShare = 'https://maps.app.goo.gl/Q4d24hPPiCNeoug77';
const mapSrc = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4070.432921113762!2d32.8841021!3d24.0255836!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x143662db2c8977b9%3A0x99f2ac49832be578!2z2KfZhNiq2YTZp9mFINmF2YTZp9mFINmF2KfZhNiq2YTZp9mFINmF2KfZhA!5e0!3m2!1sar!2seg!4v1';
const attractionFull = 'Philae Temple';
const attractionShort = 'Philae Temples';
const city = 'Aswan';
const state = 'Aswan Governorate';
const country = 'Egypt';
const countryCode = 'EG';
const postal = '1240271';
const lat = 24.0255836;
const lng = 32.8841021;
const govtUrl = 'https://www.egypt.travel/';
const heroImg = new URL('/images/aswan-nile.jpg', site).toString();

// ---- Structured data: TouristAttraction (reviews stay on-page only, NOT in JSON-LD) ----
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `https://${domain}/#attraction`,
  name: attractionFull,
  alternateName: [attractionShort, `${city} ${attractionFull}`, 'معبد فيله'],
  description: `Comprehensive visitor guide to ${attractionFull} in ${city}, ${state}, ${country}: location, how to get there, live weather, seasonal tips, and visitor services.`,
  url: `https://${domain}`,
  image: [heroImg],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${attractionFull}, Agilkia Island`,
    addressLocality: `${city} 1`,
    addressRegion: state,
    postalCode: postal,
    addressCountry: countryCode,
  },
  geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lng },
  openingHours: 'Mo-Su 07:00-17:00',
  hasMap: mapsShare,
  sameAs: [mapsShare, govtUrl],
};

// ---- Structured data: FAQPage (English canonical entity Q&A) ----
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where is Philae Temple located?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Philae Temple is located on Agilkia Island in Aswan, Aswan Governorate, Egypt, reached by boat across the Nile.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I get to Philae Temple?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'From the Philae Temple marina near the Aswan High Dam, take a short boat ride to Agilkia Island. Agree on the boat fare before boarding.',
      },
    },
    {
      '@type': 'Question',
      name: 'What are the opening hours of Philae Temple?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The site is generally open daily from around 07:00 to 17:00. Hours can shift seasonally, so verify locally before you travel.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Philae Temple free to visit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. An entrance ticket is required for the monument, and the boat transfer is usually paid separately from the site ticket.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the best time of year to visit Philae Temple?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Winter (December to February) is the most comfortable season, with mild days around 23–25°C. Summer is extremely hot, so visit at opening or closing time if you come then.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why was Philae Temple moved?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'After the High Dam raised the Nile water level, the temple was dismantled and rebuilt stone by stone on Agilkia Island in a UNESCO-led international rescue project.',
      },
    },
  ],
};

// ---- Visible (Arabic) FAQ ----
const faqs = [
  { q: 'كيف أصل إلى معبد فيله؟', a: 'من مرسى معبد فيله قرب السد العالي، تستقل قارباً قصيراً إلى جزيرة أجيليكا؛ اتفق على أجرة القارب قبل الانطلاق.' },
  { q: 'ما أفضل وقت للزيارة؟', a: 'الشتاء (ديسمبر–فبراير) هو الأريح، بأيام حوالي 23–25°م. الصيف لاهب، فزرْ عند الفتح أو الإغلاق إن زرتَه حينها.' },
  { q: 'هل القارب مشمول في التذكرة؟', a: 'عادةً تُدفع رحلة القارب بشكل منفصل عن تذكرة الموقع؛ اسأل عن السعر الإجمالي قبل ركوب القارب.' },
  { q: 'أين يقع معبد فيله؟', a: 'يقع على جزيرة أجيليكا في أسوان بمصر، ويُصل إليه بالقارب عبر مياه النيل.' },
  { q: 'ما مواعيد الفتح؟', a: 'يفتح يومياً تقريباً من 07:00 حتى 17:00، وقد تختلف المواعيد موسمياً؛ تحقّق محلياً قبل السفر.' },
  { q: 'لماذا نُقل المعبد؟', a: 'بعد أن رفع السد العالي منسوب مياه النيل، فُكّك المعبد وبُني حجراً حجراً على جزيرة أجيليكا ضمن مشروع إنقاذ دولي بإشراف اليونسكو.' },
];

// ---- Weather (server-side fetch + cache) ----
const weather = await getWeather();
const currentInfo = weather ? describeCode(weather.current.code) : null;
const today = weather?.days[0];
const advice = weather ? buildAdvice(weather) : null;
const windNow = weather ? windInfo(weather.current.wind) : null;

function weekday(dateStr: string): string {
  return new Intl.DateTimeFormat('ar-EG', { weekday: 'short' }).format(new Date(`${dateStr}T12:00:00`));
}
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- TDK -->
    <title>{attractionFull} ({city}) - Visitor Guide &amp; Location</title>
    <meta name="description" content="Discover {attractionFull} in {city}, {state}, {country}: location map, how to get there, live weather, seasonal tips, visitor services, and travel planning." />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{attractionFull} - {city} Travel Guide" />
    <meta property="og:description" content="Official visitor guide to {attractionFull} in {city}, {state}, {country}." />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={heroImg} />
    <meta property="og:image:alt" content="{attractionFull} in {city}, {country}" />
    <meta property="og:locale" content="ar_EG" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- PWA -->
    <meta name="theme-color" content="#0c6865" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="icon" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa+Ink&family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

    <!-- Analytics (Google) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-HXM22WWPKP');</script>
  </head>
  <body class="grain">
    <header class="absolute inset-x-0 top-0 z-20">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 text-white">
        <a href="#top" class="flex items-center gap-3" aria-label="معبد فيله">
          <img src="/icons/logo.svg" alt="شعار معبد فيله" class="h-12 w-12" />
          <span class="hidden text-sm font-bold tracking-wide sm:block">فيله<br /><span class="font-normal opacity-70">دليل أسوان</span></span>
        </a>
        <nav class="hidden gap-6 text-sm font-semibold lg:flex">
          <a href="#story" class="opacity-80 transition hover:opacity-100">الحكاية</a>
          <a href="#history" class="opacity-80 transition hover:opacity-100">التاريخ</a>
          <a href="#getting-there" class="opacity-80 transition hover:opacity-100">المواصلات</a>
          <a href="#weather" class="opacity-80 transition hover:opacity-100">الطقس</a>
          <a href="#services" class="opacity-80 transition hover:opacity-100">الخدمات</a>
          <a href="#faq" class="opacity-80 transition hover:opacity-100">الأسئلة</a>
        </nav>
        <a href="#map" class="rounded-full border border-white/40 px-5 py-2 text-sm font-bold backdrop-blur-sm transition hover:bg-white hover:text-[#0c6865]">افتح الخريطة</a>
      </div>
    </header>

    <main id="top">
      <!-- HERO -->
      <section class="relative flex min-h-[720px] items-end overflow-hidden bg-[#0c6865] text-white">
        <img src="/images/aswan-nile.jpg" alt="{attractionFull} - Main view in {city}, {country}" class="absolute inset-0 h-full w-full object-cover opacity-90" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#092e31] via-[#0c4e50]/35 to-[#123f42]/10"></div>
        <div class="absolute inset-0 bg-gradient-to-l from-[#092e31]/50 via-transparent to-transparent"></div>
        <div class="relative mx-auto w-full max-w-7xl px-6 pb-20 pt-40">
          <div class="max-w-2xl">
            <p class="mb-6 flex items-center gap-3 text-sm font-bold tracking-[.18em] text-[#f6c981]">
              <span class="h-px w-12 bg-[#f6c981]"></span>أسوان · مصر العليا
            </p>
            <h1 class="display text-6xl leading-[1.1] sm:text-8xl">فيله<br /><span class="text-[#f6c981]">حيث يهدأ النيل</span></h1>
            <p class="mt-7 max-w-lg text-lg leading-9 text-white/80">معبد إيزيس فوق جزيرة أجيليكا. مكان لا تُرى فيه الآثار من خلف زجاج، بل تُسمع وهي تقترب منك مع وقع المجداف.</p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#visit" class="rounded-full bg-[#e2a355] px-7 py-3.5 font-extrabold text-[#243535] transition hover:bg-[#f5bf71]">خطط لليوم</a>
              <a href="#getting-there" class="rounded-full border border-white/30 px-7 py-3.5 font-bold text-white backdrop-blur-sm transition hover:bg-white/15">كيف تصل</a>
            </div>
          </div>
        </div>
        <div class="absolute bottom-8 left-6 text-xs text-white/65 sm:left-12">24° 01′ 32″ N<br />32° 53′ 03″ E</div>
      </section>

      <!-- 01 المكان -->
      <section id="story" class="mx-auto max-w-7xl px-6 py-24">
        <div class="grid gap-14 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
          <div>
            <p class="mb-4 text-sm font-bold tracking-[.18em] text-[#0c6865]">01 · المكان</p>
            <h2 class="display text-5xl leading-tight text-[#1e2828]">جزيرة تحمل<br /><span class="text-[#0c6865]">ذاكرة كاملة</span></h2>
            <div class="mt-8 section-rule"></div>
          </div>
          <div class="text-lg leading-9 text-[#52605d]">
            <p>كان معبد فيله مكرساً للإلهة إيزيس، وبُنيت أجزاؤه في عصور بطلمية ورومانية متعاقبة. وعندما هددت مياه السد العالي الجزيرة القديمة، نُقل المجمع حجراً حجراً إلى جزيرة أجيليكا ضمن مشروع إنقاذ دولي.</p>
            <p class="mt-5">اليوم، الرحلة جزء من المعنى: قارب صغير، ماء واسع، ثم بوابة حجرية تظهر ببطء من زرقة النيل.</p>
          </div>
        </div>
        <div class="mt-16 grid gap-5 sm:grid-cols-3">
          <div class="card-lift overflow-hidden rounded-[2rem] bg-[#e8dfcf]">
            <img src="/images/nile-sailing.jpg" alt="Sailing boat on the Nile near {attractionShort}, {city}" class="h-60 w-full object-cover" loading="lazy" />
            <div class="p-5">
              <p class="text-sm font-bold text-[#0c6865]">الاقتراب</p>
              <p class="mt-2 font-bold">ابدأ من الماء</p>
            </div>
          </div>
          <div class="card-lift overflow-hidden rounded-[2rem] bg-[#e8dfcf]">
            <img src="/images/aswan-landscape.jpg" alt="Aswan landscape near {attractionShort}, {country}" class="h-60 w-full object-cover" loading="lazy" />
            <div class="p-5">
              <p class="text-sm font-bold text-[#0c6865]">المشهد</p>
              <p class="mt-2 font-bold">صخر، نخيل، وضوء</p>
            </div>
          </div>
          <div class="card-lift overflow-hidden rounded-[2rem] bg-[#e8dfcf]">
            <img src="/images/nubian-sunset.jpg" alt="Nubian sunset near {attractionShort}, {city}" class="h-60 w-full object-cover" loading="lazy" />
            <div class="p-5">
              <p class="text-sm font-bold text-[#0c6865]">الإيقاع</p>
              <p class="mt-2 font-bold">اترك وقتاً للغروب</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 التاريخ والحكاية -->
      <section id="history" class="bg-[#183f3e] py-24 text-white">
        <div class="mx-auto max-w-7xl px-6">
          <p class="mb-4 text-sm font-bold tracking-[.18em] text-[#f6c981]">02 · التاريخ والحكاية</p>
          <h2 class="display text-5xl">معبدٌ عبر ثلاثة آلاف عام</h2>
          <div class="mt-10 grid gap-10 lg:grid-cols-2">
            <div class="space-y-5 text-lg leading-9 text-white/80">
              <p>نَبَع اسم «فيله» من اليونانية، وهو تحريفٌ للاسم المصري القديم «پيلاك» (Pilak) بمعنى «الجزيرة النائية» أو «آخِر الأماكن» — إذ كانت الحدّ الجنوبي للعمارة المعبدية المصرية عند الشلال الأول للنيل.</p>
              <p>كانت فيله قِبلةً لعبادة إيزيس، إلهة السحر والأمومة؛ اجتمع عندها المصريون والنوبيون، بل وحجّاجٌ من اليونان وروما. أزدهر المعبد حتى القرن السادس الميلادي.</p>
              <p>بُني المجمع على مراحل: نواةٌ من عهد نختنبو الأول (الأسرة الثلاثين)، ثم إضافاتٌ بطلمية ورومانية، منها كشك تراجان الشهير بواجهته الرقيقة.</p>
              <p>بعد تشييد السد العالي وارتفاع منسوب بحيرة ناصر، قَرّرت اليونسكو وفريقٌ دولي نقل المعبد حجراً حجراً (1972–1980) إلى جزيرة أجيليكا المجاورة، أعلى وأبعد عن الغمر — واحدةٌ من أنجح حملات إنقاذ التراث في العالم.</p>
            </div>
            <div class="flex flex-col gap-6">
              <div class="rounded-[2rem] border border-white/15 bg-white/5 p-8">
                <p class="text-sm font-bold text-[#f6c981]">في الأساطير</p>
                <p class="mt-3 leading-8 text-white/80">في الميثولوجيا المصرية، جمعت إيزيس أشلاء أوزوريس وأعادت إليه الحياة لساعات؛ وكانت فيله إحدى المحطات المقدّسة في رحلتها. جعلت هذه القصة من المكان رمزاً للأمومة والخلود عبر العصور.</p>
              </div>
              <div class="rounded-[2rem] bg-[#0d5553] p-8">
                <p class="text-sm font-bold text-[#f6c981]">عرض الصوت والضوء</p>
                <p class="mt-3 leading-8 text-white/80">يُروى تاريخ الجزيرة ليلاً عبر عرض «الصوت والضوء» بلغاتٍ متعددة — تجربةٌ أخرى لاكتشاف فيله بعد الغروب، عندما يهدأ الحرّ ويتراقص الضوء على الأحجار.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 03 خطط زيارتك -->
      <section id="visit" class="mx-auto max-w-7xl px-6 py-24">
        <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="mb-4 text-sm font-bold tracking-[.18em] text-[#0c6865]">03 · خطط زيارتك</p>
            <h2 class="display text-5xl">خريطة اليوم المثالي</h2>
          </div>
          <div class="rounded-2xl border border-[#dfd4c1] bg-[#f4eddf] px-5 py-3 text-sm text-[#5e6b67]">
            تقييم الزوار <strong class="ml-2 text-[#0c6865]">4.8 / 5</strong><span class="text-xs">من 14,785 مراجعة</span>
          </div>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <article class="card-lift rounded-[1.5rem] bg-[#f4eddf] p-6 text-[#1e2828]">
            <span class="text-3xl">◌</span>
            <h3 class="mt-8 text-xl font-extrabold">الوقت</h3>
            <p class="mt-3 text-sm leading-7 text-[#5e6b67]">يفتح يومياً، وتعرض الخرائط الإغلاق عند الخامسة مساءً. تحقّق محلياً قبل الانطلاق.</p>
          </article>
          <article class="card-lift rounded-[1.5rem] bg-[#e2a355] p-6 text-[#1e2828]">
            <span class="text-3xl">↝</span>
            <h3 class="mt-8 text-xl font-extrabold">القارب</h3>
            <p class="mt-3 text-sm leading-7">الوصول بالقارب أساسي للتجربة. اتفق على أجرة القارب قبل الركوب؛ غالباً لا تكون ضمن تذكرة الموقع.</p>
          </article>
          <article class="card-lift rounded-[1.5rem] bg-[#c5d6c5] p-6 text-[#1e2828]">
            <span class="text-3xl">✧</span>
            <h3 class="mt-8 text-xl font-extrabold">الإيقاع</h3>
            <p class="mt-3 text-sm leading-7">احجز 2–3 ساعات للمعبد والقارب والصور، وأكثر إذا رغبت في العرض الصوتي والضوئي.</p>
          </article>
          <article class="card-lift rounded-[1.5rem] bg-[#f4eddf] p-6 text-[#1e2828]">
            <span class="text-3xl">☼</span>
            <h3 class="mt-8 text-xl font-extrabold">الموسم</h3>
            <p class="mt-3 text-sm leading-7 text-[#5e6b67]">الشتاء ألطف. في الصيف، اختر الصباح الباكر واحمل ماءً وقبعة وحذاءً مريحاً.</p>
          </article>
        </div>
        <div class="mt-16 grid gap-8 lg:grid-cols-2">
          <div class="rounded-[2rem] border border-[#dfd4c1] p-8">
            <h3 class="text-2xl font-extrabold">المصاريف باختصار</h3>
            <ul class="mt-6 space-y-4 text-sm leading-7 text-[#5e6b67]">
              <li class="flex justify-between gap-4 border-b border-[#dfd4c1] pb-4"><span>تذكرة الموقع</span><strong class="text-[#1e2828]">تختلف حسب الفئة</strong></li>
              <li class="flex justify-between gap-4 border-b border-[#dfd4c1] pb-4"><span>رحلة القارب</span><strong class="text-[#1e2828]">تُتفق مع القارب</strong></li>
              <li class="flex justify-between gap-4"><span>المعرض الصوتي والضوئي</span><strong class="text-[#1e2828]">خيار إضافي</strong></li>
            </ul>
            <p class="mt-6 text-xs text-[#0c6865]">الأسعار تتغير؛ لا نعتمد رقماً ثابتاً قديمًا.</p>
          </div>
          <div class="rounded-[2rem] bg-[#0c6865] p-8 text-white">
            <h3 class="text-2xl font-extrabold">الموقف والتنقل</h3>
            <p class="mt-5 leading-8 text-white/80">لا تتوقع موقفاً عند المعبد نفسه؛ اركن قرب المرسى أو نقطة الانطلاق، ثم أكمل بالقارب. من وسط أسوان، سيارة أجرة أو تطبيق نقل إلى المرسى هو الخيار الأبسط. اسأل السائق عن “Philae Temple boat dock”.</p>
          </div>
        </div>
      </section>

      <!-- 04 آراء الزوّار -->
      <section id="reviews" class="mx-auto max-w-7xl px-6 py-24">
        <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
          <div>
            <p class="mb-4 text-sm font-bold tracking-[.18em] text-[#0c6865]">04 · آراء الزوّار</p>
            <h2 class="display text-5xl leading-tight text-[#1e2828]">ماذا يقول<br /><span class="text-[#0c6865]">الزوّار؟</span></h2>
            <div class="mt-8 section-rule"></div>
          </div>
