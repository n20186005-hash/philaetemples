<script>const menu=document.getElementById('mobile-menu');menu?.addEventListener('click',event=>{if((event.target as HTMLElement).closest('a'))(menu as HTMLDetailsElement).open=false;});menu?.addEventListener('keydown',event=>{if(event.key==='Escape'){(menu as HTMLDetailsElement).open=false;menu.querySelector('summary')?.focus();}});</script>
